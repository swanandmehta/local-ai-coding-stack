{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:4b",
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": false,
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "qwen3.5:4b": {
          "name": "qwen3.5:4b",
          "limit": {
            "context": 20480,
            "output": 4096
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 4000
    },
    "buffer": 6000
  }
}